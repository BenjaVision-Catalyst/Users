expectvalue true
run
| phase key path runtimeName configurationPath runtime root report check wait router submit usersHost outcomes created rolledBack elevated cfg orchestrator controlHost usersConfiguration hostConfiguration |
System abortTransaction. System transactionMode: #manualBegin.
phase := System gemEnvironmentVariable: 'BVC_USERS_TRANSACTION_PHASE'.
key := (System gemEnvironmentVariable: 'BVC_USERS_TRANSACTION_ROOT') asSymbol.
path := System gemEnvironmentVariable: 'BVC_USERS_TRANSACTION_REPORT'.
runtimeName := System gemEnvironmentVariable: 'BVC_USERS_RUNTIME_NAME'.
configurationPath := System gemEnvironmentVariable: 'BVC_USERS_TRANSACTION_CONFIGURATION'.
(#('configure' 'execute' 'verify' 'deny' 'obsolete' 'cleanup') includes: phase) ifFalse: [self error: 'Unknown Users qualification phase'].
check := [:condition :message | condition ifFalse: [self error: message]].
wait := [:predicate | | deadline |
 deadline := CRPlatform current currentMillis + 15000.
 [System abortTransaction. predicate value or: [CRPlatform current currentMillis >= deadline]] whileFalse: [(Delay forMilliseconds: 25) wait].
 check value: predicate value value: 'Timed out; inspect retained Runtime, queue and evidence before retrying'].
report := Dictionary new at: 'phase' put: phase; at: 'runtime' put: runtimeName; yourself.
phase = 'configure' ifTrue: [
 cfg := CRRuntimeConfiguration new label: 'Configured authoritative Users qualification'; yourself.
 orchestrator := CROrchestrationConfiguration default heartbeatIntervalMillis: 1000; reconcileIntervalMillis: 250; yourself.
 usersConfiguration := CRServiceConfiguration new identifier: #users; label: 'Authoritative Users'; serviceClass: CUUsersService; authoritative: true; yourself.
 cfg services: {orchestrator. usersConfiguration}.
 controlHost := CRHostConfiguration new identifier: #aControl; label: 'Control'; address: 'localhost'; maxProcesses: 2; services: {CRRuntime orchestratorIdentifier}; yourself.
 hostConfiguration := CRHostConfiguration new identifier: #usersHost; label: 'Users'; address: 'localhost'; maxProcesses: 2; services: {#users}; yourself.
 cfg topology: (CRTopologyConfiguration new hosts: {controlHost. hostConfiguration}; placementStrategyConfiguration: CRRoundRobinPlacementStrategyConfiguration new; yourself).
 cfg deployment serviceDeployments: {CRServiceDeploymentConfiguration new serviceIdentifier: CRRuntime orchestratorIdentifier; label: 'Orchestrator'; initialCount: 1; yourself. CRServiceDeploymentConfiguration new serviceIdentifier: #users; label: 'Users'; initialCount: 1; yourself}.
 cfg failureEvidenceConfiguration captureDebugArtifacts: false.
 check value: cfg validate isValid value: 'Invalid qualification configuration'.
 (GsFile openWriteOnServer: configurationPath) nextPutAll: (CRRuntimeConfigurationCodec toString: cfg); close].
phase = 'configure' ifFalse: [
 runtime := CRRuntimeRegistry default runtimeNamed: runtimeName.
 phase = 'cleanup' ifFalse: [
  check value: runtime notNil value: 'Runtime must be created from configuration before submitting work'.
  router := CRWorkRouter deploymentTopology: runtime activation deploymentTopology.
  usersHost := runtime nativeHosts values detect: [:host | | publication |
   publication := runtime publications at: host workerIdentifier ifAbsent: [nil].
   publication notNil and: [(publication serviceHandleForIdentifier: #users) notNil]].
  submit := [:work :version | | envelope |
   envelope := work asEnvelope serviceIdentifier: #users; yourself.
   envelope context add: (CRDeploymentVersionContext new version: version; yourself).
   CRApplicationWorkSubmissionPolicy new validateWorkUnit: work.
   router enqueue: envelope]].
 phase = 'execute' ifTrue: [
  check value: (UserGlobals includesKey: key) not value: 'Fixture exists; inspect before retrying'.
  check value: (runtime nativeHosts values allSatisfy: [:host | host class == CRGemStoneWorkerHost]) value: 'Runtime must use the default transactional worker hosts'.
  CRGemStoneRuntime duringTransaction: [
   created := CUUser new name: 'Runtime committed user'; yourself.
   rolledBack := CUUser new name: 'Runtime rolled-back user'; yourself.
   elevated := CUUser new name: 'Runtime rejected super user'; isSuperUser: true; yourself.
   root := Dictionary new at: #runtime put: runtime; at: #originalUsers put: CUUsers allUsers copy;
    at: #createdUser put: created; at: #rolledBackUser put: rolledBack; at: #elevatedUser put: elevated; yourself.
   UserGlobals at: key put: root.
   submit value: (CUCreateUserWorkUnit user: created) value: runtime configuration version.
   submit value: ((Smalltalk at: #CUUsersFailAfterCreateTestWorkUnit) user: rolledBack) value: runtime configuration version.
   submit value: (CUCreateUserWorkUnit user: elevated) value: runtime configuration version.
   submit value: (Smalltalk at: #CUUsersDeniedTestWorkUnit) new value: runtime configuration version]].
 phase = 'verify' ifTrue: [
  root := UserGlobals at: key.
  wait value: [outcomes := usersHost executionMetrics samples select: [:sample | #('CUCreateUserWorkUnit' 'CUUsersFailAfterCreateTestWorkUnit' 'CUUsersDeniedTestWorkUnit') includes: sample workUnitClass name asString]. outcomes size = 4].
  check value: (CUUsers allUsers identityIncludes: (root at: #createdUser)) value: 'Creation did not commit'.
  check value: ((CUUsers allUsers identityIncludes: (root at: #rolledBackUser)) not) value: 'Failed body mutation survived rollback'.
  check value: ((CUUsers allUsers identityIncludes: (root at: #elevatedUser)) not) value: 'Elevated user was created'.
  check value: (CUUsers allUsers size = ((root at: #originalUsers) size + 1)) value: 'Unexpected Users store changes'.
  check value: (outcomes first isSuccessful and: [outcomes first transactionOutcome = #committed]) value: 'Committed creation evidence differs'.
  check value: (outcomes second transactionOutcome = #aborted) value: 'Failed body lacks aborted evidence'.
  check value: (usersHost failures asArray anySatisfy: [:failure | failure errorClassName asString = 'CUUserCreationError']) value: 'Missing business rejection evidence'.
  check value: (usersHost failures asArray anySatisfy: [:failure | failure errorClassName asString = 'CRCapabilityDeniedException']) value: 'Missing capability denial evidence'.
  check value: usersHost controlQueue isEmpty value: 'Queue still owns a delivery'.
  report at: 'independentGemRead' put: true; at: 'committedCreation' put: true; at: 'rollbackAfterMutation' put: true; at: 'superUserRejected' put: true; at: 'unrelatedWorkDenied' put: true;
   at: 'outcomes' put: (outcomes collect: [:sample | {sample workUnitClass name asString. sample isSuccessful. sample transactionOutcome asString. sample completionRecordingOutcome asString}]) asArray].
 phase = 'deny' ifTrue: [
  root := UserGlobals at: key. cfg := runtime configuration. (cfg serviceConfigurationNamed: #users) authoritative: false.
  runtime configure: cfg.
  wait value: [| publication | publication := runtime publications at: usersHost workerIdentifier. (publication serviceHandleForIdentifier: #users) appliedConfigurationVersion = runtime configuration version].
  CRGemStoneRuntime duringTransaction: [created := CUUser new name: 'Rejected non-authoritative user'; yourself. root at: #refusedUser put: created. submit value: (CUCreateUserWorkUnit user: created) value: runtime configuration version].
  wait value: [usersHost failures asArray anySatisfy: [:failure | failure workUnitClassName asString = 'CUCreateUserWorkUnit' and: [failure errorClassName asString = 'CRCapabilityDeniedException']]].
  check value: ((CUUsers allUsers identityIncludes: created) not) value: 'Non-authoritative service created a user'.
  report at: 'liveAuthorityChangeEnforced' put: true; at: 'configurationVersion' put: runtime configuration version].
 phase = 'obsolete' ifTrue: [
  root := UserGlobals at: key.
  CRGemStoneRuntime duringTransaction: [created := CUUser new name: 'Rejected obsolete configuration user'; yourself. root at: #obsoleteUser put: created. submit value: (CUCreateUserWorkUnit user: created) value: runtime configuration version - 1].
  wait value: [usersHost executionMetrics samples anySatisfy: [:sample | sample workUnitClass == CUCreateUserWorkUnit and: [sample transactionOutcome = #skipped]]].
  check value: ((CUUsers allUsers identityIncludes: created) not) value: 'Obsolete work created a user'.
  check value: usersHost controlQueue isEmpty value: 'Obsolete delivery was not acknowledged'.
  report at: 'obsoleteVersionSkipped' put: true].
 phase = 'cleanup' ifTrue: [
  root := UserGlobals at: key. runtime := root at: #runtime.
  check value: (runtime status = CRStatus stopped) value: 'Stop the qualification Runtime before cleanup'.
  CRGemStoneRuntime duringTransaction: [
   CUUsers allUsers remove: (root at: #createdUser).
   (root at: #originalUsers) do: [:user | check value: (CUUsers allUsers identityIncludes: user) value: 'Original user changed'].
   UserGlobals removeKey: key].
  report at: 'createdUserRemoved' put: true; at: 'originalUsersPreserved' put: true; at: 'fixtureRootRemoved' put: true]].
(GsFile openWriteOnServer: path) nextPutAll: (STON toJsonString: report); close.
true
%
