expectvalue true
run
| directory phase file parameters runtimeName key runtime root report configuration users orchestrator control application services deployments selected client gate created expected hosts samples cadence |
System abortTransaction. System transactionMode: #manualBegin.
directory := System gemEnvironmentVariable: 'BVC_USERS_PLATFORM_DIRECTORY'.
phase := System gemEnvironmentVariable: 'BVC_USERS_PLATFORM_PHASE'.
file := GsFile openReadOnServer: directory, '/parameters.json'.
[parameters := STONJSON fromString: file contents asByteArray utf8Decoded] ensure: [file close].
runtimeName := parameters at: 'runtime'. key := (runtimeName, '_platform_qualification') asSymbol.
runtime := CRRuntimeRegistry default runtimeNamed: runtimeName.
report := Dictionary new at: 'phase' put: phase; at: 'runtime' put: runtimeName; yourself.
phase = 'configure' ifTrue: [
 runtime ifNotNil: [self error: 'Qualification Runtime already exists'].
 (UserGlobals includesKey: key) ifTrue: [self error: 'Qualification root already exists'].
 cadence := parameters at: 'cadenceConfiguration' ifAbsent: [Dictionary new].
 orchestrator := CROrchestrationConfiguration default heartbeatIntervalMillis: (cadence at: 'heartbeatIntervalMillis' ifAbsent: [500]); reconcileIntervalMillis: (cadence at: 'reconcileIntervalMillis' ifAbsent: [100]); yourself.
 users := CUUsersConfiguration new identifier: #users; label: 'Authoritative Users'; authoritative: true; maximumFeeds: (parameters at: 'maximumFeeds' ifAbsent: [16]); maximumUsersPerFeed: (parameters at: 'maximumUsersPerFeed' ifAbsent: [256]); yourself.
 services := OrderedCollection with: orchestrator with: users.
 (parameters at: 'clients') do: [:spec | | connect target identifier |
  identifier := ('connect_', (spec at: 'name')) asSymbol.
  file := GsFile openReadOnServer: (spec at: 'serverOptions').
  [connect := CCQuicConfiguration new nativeProtocolVersion: 2; identifier: identifier; label: ((parameters at: 'fanout' ifAbsent: [false]) ifTrue: [directory] ifFalse: ['Platform Users endpoint']);
   nativeOptionsJson: file contents; libraryPath: (parameters at: 'library'); principal: (spec at: 'name');
   readinessEnabled: (parameters at: 'readinessEnabled' ifAbsent: [false]); idleMillis: (cadence at: 'idleMillis' ifAbsent: [20]); allowedOperations: #(1 2 3 4 5 6 7 8 9 65534); applicationClass: ((parameters at: 'fanout' ifAbsent: [false]) ifTrue: [CUUsersFanoutApplicationFixture] ifFalse: [CUUsersCommitGateApplicationFixture]); yourself] ensure: [file close].
  (parameters at: 'driveTriggers' ifAbsent: [false]) ifTrue: [connect applicationClass: CUUsersDriveTriggerApplicationFixture].
  target := CRServiceBindingConfiguration new identifier: #users; label: 'Users'; serviceIdentifier: #users; yourself.
  connect bindings: {target}. services add: connect].
 configuration := CRRuntimeConfiguration new label: 'Native platform Users qualification'; services: services asArray; yourself.
 control := CRHostConfiguration new identifier: #aControl; label: 'Control'; address: 'localhost'; maxProcesses: 1; services: {CRRuntime orchestratorIdentifier}; yourself.
 selected := (services reject: [:service | service identifier = CRRuntime orchestratorIdentifier]) collect: [:service | service identifier].
 application := CRHostConfiguration new identifier: #application; label: 'Users and Connect'; address: 'localhost'; maxProcesses: 1; services: selected asArray; yourself.
 configuration topology: (CRTopologyConfiguration new hosts: {control. application}; placementStrategyConfiguration: CRRoundRobinPlacementStrategyConfiguration new; yourself).
 deployments := services collect: [:service | CRServiceDeploymentConfiguration new serviceIdentifier: service identifier; label: service label; initialCount: 1; yourself].
 configuration deployment serviceDeployments: deployments asArray. configuration failureEvidenceConfiguration captureDebugArtifacts: false.
 (CRRuntimeConfigurationCodec decodeValue: (CRRuntimeConfigurationCodec encodeValue: services last)) nativeProtocolVersion = 2 ifFalse: [self error: 'Serialized protocol selection lost'].
 configuration validate isValid ifFalse: [self error: 'Invalid platform Users configuration'].
 (GsFile openWriteOnServer: directory, '/runtime.ston') nextPutAll: (CRRuntimeConfigurationCodec toString: configuration); close.
 CRGemStoneRuntime duringTransaction: [UserGlobals at: key put: (Dictionary new at: #originalUsers put: CUUsers allUsers copy; at: #originalGateDirectory put: CUUsersCommitGateMessageFixture gateDirectory; yourself)].
 report at: 'configurationValid' put: true].
phase = 'gate' ifTrue: [
 client := parameters at: 'activeClient'. gate := client at: 'output'.
 CRGemStoneRuntime duringTransaction: [CUUsersCommitGateMessageFixture gateDirectory: gate].
 report at: 'trustedGateConfigured' put: true].
phase = 'beforeCommit' ifTrue: [
 client := parameters at: 'activeClient'. created := CUUsers allUsers select: [:user | user name = ((client at: 'prefix'), ':hold')].
 created isEmpty ifFalse: [self error: 'Held insertion became visible before the commit gate was released'].
 report at: 'independentGemRead' put: true; at: 'heldUserVisible' put: false].
phase = 'afterCommit' ifTrue: [
 client := parameters at: 'activeClient'. created := CUUsers allUsers select: [:user | user name = ((client at: 'prefix'), ':hold')].
 (created size = 1 and: [created first isSuperUser not]) ifFalse: [self error: 'Returned user is not visible in an independent Gem'].
 report at: 'independentGemRead' put: true; at: 'committedUser' put: created first name].
phase = 'liveBeforeCommit' ifTrue: [
 client := parameters at: 'activeClient'. created := CUUsers allUsers select: [:user | user creationName = ((client at: 'prefix'), ':lost-create')].
 created isEmpty ifFalse: [self error: 'Live insertion visible before commit'].
 report at: 'independentGemRead' put: true; at: 'heldUserVisible' put: false].
phase = 'liveAfterCommit' ifTrue: [
 client := parameters at: 'activeClient'. created := CUUsers allUsers select: [:user | user creationName = ((client at: 'prefix'), ':lost-create')].
 (created size = 1 and: [created first userIdentifier notEmpty and: [created first creationIdentifier notEmpty]]) ifFalse: [self error: 'Recovery receipt must belong to exactly one committed User'].
 report at: 'independentGemRead' put: true; at: 'oneCommittedIdentity' put: true].
phase = 'quietBefore' ifTrue: [
 hosts := runtime nativeHosts values select: [:host | ((runtime publications at: host workerIdentifier) serviceHandleForIdentifier: #users) notNil].
 samples := hosts first executionMetrics samples.
 selected := samples last sequence. root := UserGlobals at: key.
 CRGemStoneRuntime duringTransaction: [root at: #idleSequence put: selected].
 report at: 'sequence' put: selected].
phase = 'quietAfter' ifTrue: [
 hosts := runtime nativeHosts values select: [:host | ((runtime publications at: host workerIdentifier) serviceHandleForIdentifier: #users) notNil].
 samples := hosts first executionMetrics samples.
 selected := (UserGlobals at: key) at: #idleSequence.
 samples first sequence > (selected + 1) ifTrue: [self error: 'Idle audit window was evicted'].
 (samples anySatisfy: [:sample | sample sequence > selected and: [#(CUReadLiveUserWork CUReceiveUserChangesWork) includes: sample workUnitClass name]]) ifTrue: [self error: 'Idle observers issued reads or subscription renewals'].
 report at: 'fromSequence' put: selected; at: 'toSequence' put: samples last sequence; at: 'zeroIdleReads' put: true; at: 'zeroIdleReceiveRequests' put: true].
phase = 'pushBeforeCommit' ifTrue: [
 client := parameters at: 'activeClient'. created := CUUsers allUsers select: [:user | user name = ((client at: 'prefix'), ':push-held')].
 created isEmpty ifFalse: [self error: 'Held edit visible before commit'].
 report at: 'heldUpdateVisible' put: false].
phase = 'pushAfterCommit' ifTrue: [
 client := parameters at: 'activeClient'. created := CUUsers allUsers select: [:user | user creationName = ((client at: 'prefix'), ':push-original')].
 (created size = 1 and: [created first revision >= 2]) ifFalse: [self error: 'Committed edit not visible'].
 report at: 'committedUpdateVisible' put: true].
phase = 'verifyPush' ifTrue: [
 created := CUUsers allUsers select: [:user | user name beginsWith: (parameters at: 'prefix')].
 expected := (parameters at: 'clients') collect: [:spec | (spec at: 'prefix'), ':push-reconnected'].
 ((created collect: #name) asArray sort = expected asArray sort) ifFalse: [self error: 'Unexpected pushed Users store contents'].
 hosts := runtime nativeHosts values select: [:host | ((runtime publications at: host workerIdentifier) serviceHandleForIdentifier: #users) notNil].
 samples := hosts first executionMetrics samples.
 selected := samples count: [:sample | sample workUnitClass == CUReadLiveUserWork].
 report at: 'subscriptionSetupAndProbeSamples' put: (samples count: [:sample | sample workUnitClass == CUReceiveUserChangesWork]).
 report at: 'readAndProbeSamples' put: selected; at: 'noPeriodicReads' put: true.
 selected := samples select: [:sample | sample workUnitClass == CUUsersFlushWork].
 (selected notEmpty and: [selected allSatisfy: [:sample | sample isSuccessful and: [sample transactionOutcome = #committed and: [sample completionRecordingOutcome = #recorded]]]]) ifFalse: [self error: 'Push publication commit evidence missing'].
 report at: 'committedPublications' put: selected size; at: 'expectedUsersPersisted' put: true].
phase = 'verify' ifTrue: [
 root := UserGlobals at: key.
 created := CUUsers allUsers select: [:user | user name beginsWith: (parameters at: 'prefix')].
 expected := OrderedCollection new.
 (parameters at: 'clients') do: [:spec | expected add: (spec at: 'prefix'), ':hold'; add: (spec at: 'reconnectedName'); add: (spec at: 'prefix'), ':duplicate'; add: (spec at: 'prefix'), ':duplicate'; add: (spec at: 'prefix'), ':live-authority'; add: (spec at: 'prefix'), ':recovered-edit'].
 ((created collect: [:user | user name]) asArray sort = expected asArray sort) ifFalse: [self error: 'Only committed platform calls must persist, without replay'].
 (root at: #originalUsers) do: [:user | (CUUsers allUsers identityIncludes: user) ifFalse: [self error: 'Original user missing']].
 hosts := runtime nativeHosts values select: [:host | ((runtime publications at: host workerIdentifier) serviceHandleForIdentifier: #users) notNil].
 (hosts size = 1 and: [hosts first class == CRGemStoneWorkerHost]) ifFalse: [self error: 'Configured default worker required'].
 samples := hosts first executionMetrics samples select: [:sample | sample workUnitClass == CUCreateLiveUserGateWork].
 (samples notEmpty and: [samples allSatisfy: [:sample | sample completionRecordingOutcome = #recorded]]) ifFalse: [self error: 'Commit completion evidence missing'].
 (hosts first failures asArray anySatisfy: [:failure | failure errorMessage includesSubstring: 'Qualification failure after live Users insertion.']) ifFalse: [self error: 'Post-insertion rollback evidence missing'].
 report at: 'lookupSamples' put: ((hosts first executionMetrics samples select: [:sample | (#(CUReadLiveUserWork CUReceiveUserChangesWork) includes: sample workUnitClass name)]) collect: [:sample |
  (sample isSuccessful and: [sample transactionOutcome = #committed and: [sample completionRecordingOutcome = #recorded]]) ifFalse: [self error: 'Lookup did not use committed Runtime completion'].
  {sample isSuccessful. sample transactionOutcome asString. sample completionRecordingOutcome asString}]) asArray.
 (report at: 'lookupSamples') isEmpty ifTrue: [self error: 'No authoritative lookup execution evidence'].
 report at: 'defaultTransactionalWorker' put: true; at: 'onlySuccessfulUsersPersisted' put: true; at: 'createdCodepoints' put: (created collect: [:user | user name asArray collect: [:char | char asciiValue]]) asArray;
  at: 'outcomes' put: (samples collect: [:sample | {sample isSuccessful. sample transactionOutcome asString. sample completionRecordingOutcome asString}]) asArray].
phase = 'fanoutVerify' ifTrue: [
 services := runtime configuration services.
 orchestrator := services detect: [:service | service identifier = CRRuntime orchestratorIdentifier].
 selected := services detect: [:service | service isKindOf: CCQuicConfiguration].
 report at: 'readinessEnabled' put: selected readinessEnabled.
 report at: 'cadenceConfiguration' put: (Dictionary new at: 'idleMillis' put: selected idleMillis;
  at: 'reconcileIntervalMillis' put: orchestrator reconcileIntervalMillis;
  at: 'heartbeatIntervalMillis' put: orchestrator heartbeatIntervalMillis; yourself).
 expected := parameters at: 'expectedUsers'.
 created := CUUsers allUsers select: [:user | user name beginsWith: (parameters at: 'prefix')].
 created size = expected size ifFalse: [self error: 'Unexpected fan-out Users count'].
 expected do: [:state | | user |
  user := created detect: [:each | each userIdentifier = (state at: 'userIdentifier')] ifNone: [self error: 'Fan-out identity was not persisted'].
  (user name = (state at: 'name') and: [user revision = (state at: 'revision')]) ifFalse: [self error: 'Final fan-out state was not persisted']].
 hosts := runtime nativeHosts values select: [:host | ((runtime publications at: host workerIdentifier) serviceHandleForIdentifier: #users) notNil].
 (hosts size = 1 and: [hosts first class == CRGemStoneWorkerHost]) ifFalse: [self error: 'Configured default transactional worker required'].
 samples := hosts first executionMetrics samples select: [:sample | sample workUnitClass == CUUsersFlushWork].
 (samples notEmpty and: [samples allSatisfy: [:sample | sample isSuccessful and: [sample transactionOutcome = #committed and: [sample completionRecordingOutcome = #recorded]]]]) ifFalse: [self error: 'Fan-out publication commit evidence missing'].
 report at: 'expectedUsersPersisted' put: true; at: 'independentGemRead' put: true;
  at: 'userCount' put: created size; at: 'committedPublicationSamplesRetained' put: samples size;
  at: 'defaultTransactionalWorker' put: true].
phase = 'cleanup' ifTrue: [
 runtime ifNotNil: [self error: 'Stop and remove the owned Runtime first'].
 root := UserGlobals at: key.
 CRGemStoneRuntime duringTransaction: [
  created := CUUsers allUsers select: [:user | user name beginsWith: (parameters at: 'prefix')].
  created do: [:user | CUUsers allUsers remove: user].
  (root at: #originalUsers) do: [:user | (CUUsers allUsers identityIncludes: user) ifFalse: [self error: 'Original user missing']].
  CUUsersCommitGateMessageFixture gateDirectory: (root at: #originalGateDirectory).
  UserGlobals removeKey: key].
 report at: 'removedUsers' put: created size; at: 'originalUsersPreserved' put: true; at: 'gateRestored' put: true].
(GsFile openWriteOnServer: directory, '/', phase, '.json') nextPutAll: (STON toJsonString: report) utf8Encoded asString; close.
true
%
